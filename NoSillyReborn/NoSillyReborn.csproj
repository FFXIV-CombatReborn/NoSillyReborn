<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
	<PropertyGroup>
		<Description>No Silly Reborn intercepts your action inputs during combat and replaces incorrect actions with the correct ones based on your current job state</Description>
		<Author>The Combat Reborn Team</Author>
		<Name>No Silly Reborn</Name>
		<Punchline>For those who click their own buttons, but sometimes click the wrong ones.</Punchline>
		<AssemblyName>NoSillyReborn</AssemblyName>
		<Version>0.0.0.1</Version>
		<PackageProjectUrl>https://github.com/FFXIV-CombatReborn/NoSillyReborn</PackageProjectUrl>
		<PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
		<IsPackable>false</IsPackable>
		<TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
		<SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
		<EnableWindowsTargeting>true</EnableWindowsTargeting>
		<OutputPath>$(SolutionDir)bin\$(Configuration)\</OutputPath>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="ECommons" Version="3.2.1.26" />
		<PackageReference Include="RebornMaterial" Version="7.5.8.5" />
		<PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Update="DalamudPackager" Version="15.0.0" />
		<PackageReference Update="DotNet.ReproducibleBuilds" Version="2.0.5" />
		<ProjectReference Include="..\NoSillyReborn.SourceGenerators\NoSillyReborn.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="OutputPath;_CommandLineDefinedOutputPath" />
		<AdditionalFiles Include="..\BannedSymbols.txt" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resources\NSR_Icon.png" LogicalName="NoSillyReborn.Resources.NSR_Icon.png" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="System.ComponentModel" />
		<Using Include="Dalamud.Bindings.ImGui" />
		<Using Include="Dalamud.Game.ClientState.Objects.Types" />
		<Using Include="Dalamud.Interface" />
		<Using Include="ECommons.DalamudServices" />
		<Using Include="ECommons.ExcelServices" />
		<Using Include="Newtonsoft.Json" />
		<Using Include="RebornMaterial" />
		<Using Include="NoSillyReborn.Configuration" />
		<Using Include="NoSillyReborn.Engine" />
		<Using Include="NoSillyReborn.Engine.Data" />
		<Using Include="NoSillyReborn.Engine.Helpers" />
		<Using Include="NoSillyReborn.Engine.State" />
		<Using Include="NoSillyReborn.Integrations.IPC" />
		<Using Include="NoSillyReborn.Intercept" />
		<Using Include="NoSillyReborn.Rules" />
	</ItemGroup>

	<Target Name="PruneOutputDlls" AfterTargets="ResolveReferences">
		<ItemGroup>
			<ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)' != 'ECommons' and '%(Filename)' != 'RebornMaterial'" />
		</ItemGroup>
	</Target>
</Project>
